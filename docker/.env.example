# Cloudflare Access — Zero Trust dashboard
# Team domain, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# AUD tag of the Access application for the browser (kakebo.undermix.it)
CF_ACCESS_AUD_WEB=
# AUD tag of the Access application for the native apps (kakebo-api.undermix.it, Service Auth) — leave empty until the native apps exist
CF_ACCESS_AUD_API=

# Optional: image tag to run (default: latest), e.g. 2026.11.10-b1
# KAKEBO_TAG=latest
# Optional: host address/port published on the LAN for cloudflared (default: 0.0.0.0:8080)
# KAKEBO_BIND=192.168.1.10
# KAKEBO_PORT=8080

# Local development ONLY (the server refuses to start with this in production):
# DEV_FAKE_IDENTITY=dev@example.com
