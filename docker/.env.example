# Cloudflare Access — Zero Trust dashboard
# Team domain, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# AUD tag of the Access application for the browser (kakebo.<domain>)
CF_ACCESS_AUD_WEB=
# AUD tag of the Access application for the native apps (api.kakebo.<domain>, Service Auth)
CF_ACCESS_AUD_API=

# Optional: image tag to run (default: latest), e.g. 2026.11.10-b1
# KAKEBO_TAG=latest
# Optional: name of the Docker network shared with cloudflared (default: cloudflared)
# CLOUDFLARED_NETWORK=cloudflared

# Local development ONLY (the server refuses to start with this in production):
# DEV_FAKE_IDENTITY=dev@example.com
